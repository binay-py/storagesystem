{
  "name": "sanduk",
  "short_name": "sanduk",
  "description": "your locked chest in the cloud",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#120f0d",
  "theme_color": "#120f0d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "media", "accept": ["image/*", "video/*"] }
      ]
    }
  }
}
