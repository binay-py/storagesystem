name = "sanduk"
main = "src/worker.js"
compatibility_date = "2026-08-01"

[assets]
directory = "./public"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "sanduk"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
# Use "SETUP" for first deploy to enable /api/setup/* discovery endpoints.
# Replace with your real private Telegram channel id (usually starts with -100) after setup.
TG_CHAT_ID = "SETUP"
